@page "/tasks/{TaskId:int}"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject ITaskService TaskService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Task Details - ContosoDashboard</PageTitle>
<div class="container-fluid">
@if (task == null) { <p><em>Loading...</em></p> } else {
    <h1>@task.Title</h1><p>@task.Description</p><p>Status: <strong>@task.Status</strong> | Priority: <strong>@task.Priority</strong></p>
    <section aria-labelledby="task-documents-heading"><h2 id="task-documents-heading" class="h4">Related Documents</h2>@if (documents.Count == 0) { <p class="text-muted">No documents attached.</p> } else { <ul>@foreach (var document in documents) { <li><a href="/documents/@document.DocumentId">@document.Title</a></li> }</ul> }<a class="btn btn-outline-primary" href="/documents">Manage documents</a><div class="mt-3"><label class="form-label" for="task-file">Attach document</label><InputFile id="task-file" OnChange="SelectFile" /><input class="form-control mt-2" placeholder="Document title" @bind="documentTitle" /><button class="btn btn-primary mt-2" disabled="@(file == null)" @onclick="Upload">Upload attachment</button></div></section>
}
</div>
@code {
    [Parameter] public int TaskId { get; set; }
    private TaskItem? task; private List<Document> documents = []; private int userId;
    private IBrowserFile? file; private string documentTitle = string.Empty;
    protected override async Task OnInitializedAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out userId); task = await TaskService.GetTaskByIdAsync(TaskId, userId); if (task == null) { Navigation.NavigateTo("/tasks"); return; } documents = await TaskService.GetTaskDocumentsAsync(TaskId, userId); }
    private void SelectFile(InputFileChangeEventArgs args) => file = args.File;
    private async Task Upload() { if (file == null || task == null) return; using var input = file.OpenReadStream(DocumentRules.MaxFileSize); using var memory = new MemoryStream(); await input.CopyToAsync(memory); memory.Position = 0; await DocumentService.UploadAsync(memory, file.Name, file.ContentType, file.Size, new DocumentUploadRequest(documentTitle, null, "Project Documents", null, task.ProjectId, TaskId), userId); file = null; documents = await TaskService.GetTaskDocumentsAsync(TaskId, userId); }
}
