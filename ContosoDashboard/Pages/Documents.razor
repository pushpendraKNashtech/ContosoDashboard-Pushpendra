@page "/documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4"><h1>Documents</h1><button class="btn btn-primary" @onclick="OpenUpload">Upload Documents</button></div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(error ? "alert-danger" : "alert-success")" role="status">@message</div> }
    @if (uploadOpen)
    {
        <div class="card mb-4"><div class="card-body"><h2 class="h5">Upload document</h2><div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="document-file">Files</label><InputFile id="document-file" OnChange="SelectFiles" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" /></div>
            <div class="col-md-6"><label class="form-label" for="document-title">Title</label><input id="document-title" class="form-control" @bind="title" required /></div>
            <div class="col-md-4"><label class="form-label" for="document-category">Category</label><select id="document-category" class="form-select" @bind="category"><option value="">Select category</option>@foreach (var value in DocumentRules.Categories) { <option value="@value">@value</option> }</select></div>
            <div class="col-md-8"><label class="form-label" for="document-description">Description</label><input id="document-description" class="form-control" @bind="description" /></div>
        </div><div class="mt-3"><button class="btn btn-primary me-2" disabled="@(selectedFiles.Count == 0 || uploading)" @onclick="Upload">@(uploading ? "Uploading..." : "Upload")</button><button class="btn btn-outline-secondary" @onclick="CloseUpload">Cancel</button></div></div></div>
    }
    <div class="row g-2 mb-3"><div class="col-md-5"><label class="visually-hidden" for="document-search">Search documents</label><input id="document-search" class="form-control" placeholder="Search documents" @bind="search" @bind:event="oninput" /></div><div class="col-md-3"><label class="visually-hidden" for="document-sort">Sort</label><select id="document-sort" class="form-select" @bind="sort"><option value="date">Upload date</option><option value="title">Title</option><option value="category">Category</option><option value="size">File size</option></select></div><div class="col-md-2 form-check document-filter"><input id="shared-only" class="form-check-input" type="checkbox" @bind="sharedOnly" /><label class="form-check-label" for="shared-only">Shared with me</label></div><div class="col-md-2"><button class="btn btn-secondary w-100" @onclick="LoadDocuments">Apply</button></div></div>
    @if (documents == null) { <p><em>Loading...</em></p> } else if (documents.Count == 0) { <div class="alert alert-info">No documents found.</div> } else { <div class="table-responsive"><table class="table"><caption class="visually-hidden">Authorized documents</caption><thead><tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th>Actions</th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@document.Title<br /><small class="text-muted">@document.OriginalFileName</small></td><td>@document.Category</td><td>@document.UploadedDate.ToLocalTime().ToString("MMM dd, yyyy")</td><td>@FormatSize(document.FileSizeBytes)</td><td>@(document.Project?.Name ?? "Personal")</td><td><a class="btn btn-sm btn-outline-primary" href="/documents/file/@document.DocumentId" target="_blank">Open</a></td></tr> }</tbody></table></div> }
</div>

@code {
    private List<Document>? documents; private IReadOnlyList<IBrowserFile> selectedFiles = []; private bool uploadOpen; private bool uploading; private bool error; private bool sharedOnly; private string? message; private string title = ""; private string category = ""; private string? description; private string search = ""; private string sort = "date"; private int userId;
    protected override async Task OnInitializedAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out userId); await LoadDocuments(); }
    private async Task LoadDocuments() => documents = await DocumentService.SearchAsync(userId, new DocumentQuery(search, null, null, null, null, sort, true, null, sharedOnly));
    private void OpenUpload() { uploadOpen = true; message = null; }
    private void CloseUpload() { uploadOpen = false; selectedFiles = []; }
    private void SelectFiles(InputFileChangeEventArgs args) => selectedFiles = args.GetMultipleFiles(20);
    private async Task Upload() { uploading = true; message = null; error = false; foreach (var file in selectedFiles) { try { using var stream = file.OpenReadStream(DocumentRules.MaxFileSize); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); memory.Position = 0; var result = await DocumentService.UploadAsync(memory, file.Name, file.ContentType, file.Size, new DocumentUploadRequest(title, description, category, null, null, null), userId); if (!result.Success) { error = true; message = result.Error; break; } message = "Upload completed successfully."; } catch (Exception ex) { error = true; message = ex.Message; break; } } uploading = false; await LoadDocuments(); if (!error) CloseUpload(); }
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.0} KB" : $"{bytes / 1024d / 1024d:0.0} MB";
}
